APP_NAME=DoobyScoo Multiplayer Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql://doobyscoo:doobyscoo_dev_password@localhost:5432/doobyscoo
FALLBACK_SQLITE_PATH=./doobyscoo_server.db
JWT_SECRET_KEY=replace-this-with-a-strong-random-64-byte-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=*
MATCH_EXPIRATION_SECONDS=600
MATCHMAKING_EXPIRATION_SECONDS=180
MATCHMAKING_INITIAL_TROPHY_RANGE=200
MATCHMAKING_RANGE_EXPANSION_PER_SEC=25
MAX_MATCH_STEPS=300
TROPHY_WIN_REWARD=25
TROPHY_LOSS_PENALTY=15
TROPHY_DRAW_REWARD=5
XP_MATCH_PARTICIPATION=25
XP_MATCH_WIN=50
XP_PERSONAL_BEST=30
XP_LEAGUE_ADVANCEMENT=100
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BYTES=1048576

